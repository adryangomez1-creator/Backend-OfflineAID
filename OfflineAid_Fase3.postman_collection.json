	"item": [
		{
			"name": "1. Sincronización Offline",
			"item": [
				{
					"name": "1.1 Descargar datos offline (Precarga local)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/sync/datos-offline?id_usuario=3",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "sync", "datos-offline"],
							"query": [
								{ "key": "id_usuario", "value": "3" }
							]
						}
					}
				},
				{
					"name": "1.2 Sincronización por lote (Batch Sync con temp_id)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id_usuario\": 3,\n  \"operaciones\": [\n    {\n      \"temp_id\": \"temp-emergencia-001\",\n      \"tipo_operacion\": \"CREAR_EMERGENCIA\",\n      \"payload\": {\n        \"id_tipo\": 1,\n        \"titulo\": \"Accidente vehicular en zona rural sin red\",\n        \"descripcion\": \"Colisión frontal en tramo montañoso sin señal de telefonía.\",\n        \"latitud\": 14.6500,\n        \"longitud\": -90.5200,\n        \"direccion\": \"Km 42 Carretera a San Juan Sacatepéquez\"\n      }\n    },\n    {\n      \"temp_id\": \"temp-foto-002\",\n      \"tipo_operacion\": \"SUBIR_EVIDENCIA\",\n      \"payload\": {\n        \"id_emergencia\": \"temp-emergencia-001\",\n        \"url_imagen\": \"https://offlineaid.test/fotos/choque_offline.jpg\"\n      }\n    },\n    {\n      \"temp_id\": \"temp-gps-003\",\n      \"tipo_operacion\": \"ACTUALIZAR_UBICACION\",\n      \"payload\": {\n        \"id_emergencia\": \"temp-emergencia-001\",\n        \"latitud\": 14.6520,\n        \"longitud\": -90.5215,\n        \"direccion\": \"Km 42.3 Carretera a San Juan\"\n      }\n    }\n  ]\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/sync/batch",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "sync", "batch"]
						}
					}
				},
				{
					"name": "1.3 Ver cola offline pendiente o con error",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/cola-offline/pendientes",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "cola-offline", "pendientes"]
						}
					}
				}
			]
		},
